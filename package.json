{
  "name": "@local/desk-workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "model.js",
    "library-store.js",
    "library-routes.js"
  ],
  "dependencies": {
    "fflate": "^0.8.3",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "preview": "node tests/preview-server.mjs",
    "test:features": "node tests/features-browser.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
