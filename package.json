{
  "name": "@local/desk-workbench",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "model.js",
    "library-store.js",
    "library-routes.js",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "fflate": "^0.8.3",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "name": "成果工作台 · DSH Dock",
    "category": "ui"
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "preview": "node tests/preview-server.mjs",
    "test:features": "node tests/features-browser.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "main": "./index.js",
  "description": "自动整理 DeepSeek Harness 会话中的网页、演示稿、图片、文档和代码，支持成果星标、版本保存、复用与工作回顾。",
  "author": "mimiqiao",
  "license": "MIT",
  "homepage": "https://github.com/mimiqiao/DSH-Dock#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mimiqiao/DSH-Dock.git"
  },
  "bugs": {
    "url": "https://github.com/mimiqiao/DSH-Dock/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dock",
    "artifacts",
    "workbench"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-rc.1"
  }
}
